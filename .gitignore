# Secrets — never commit the endpoint key
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/

# Run artifacts. Everything the writeup actually cites is recorded under
# fixtures/ instead, so a clean checkout can reproduce it without these.
runs/
out/
*.log
answers*.json
!example_answers.json

# Interview preparation material. Deliberately untracked: the repository is the
# take-home submission, and this is personal prep that does not belong in it.
interview/

# Where the review archive is built, by `git archive`. Tracking it would make
# each build swallow the previous one.
dist/
